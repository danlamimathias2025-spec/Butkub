rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN';
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid) && 
        request.resource.data.keys().hasAll(['uid', 'email', 'role', 'kycStatus', 'createdAt']) &&
        (request.resource.data.kycStatus == 'PENDING' || request.resource.data.kycStatus == 'VERIFIED');
      allow update: if isOwner(uid) || isAdmin();
      allow delete: if isAdmin();

      match /transactions/{transactionId} {
        allow read: if isOwner(uid) || isAdmin();
        allow write: if isOwner(uid) || isAdmin();
      }

      match /balances/{assetId} {
        allow read: if isOwner(uid) || isAdmin();
        allow write: if isOwner(uid) || isAdmin();
      }
    }

    // Global transactions view for admin
    match /users/{uid}/transactions/{transactionId} {
       allow list: if isAdmin();
    }
    
    // For admin user search/list
    match /users/{uid} {
       allow list: if isAdmin();
    }
  }
}
