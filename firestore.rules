rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN' ||
        request.auth.token.email == 'danlamimathias2025@gmail.com'
      );
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, list: if true; 
      allow create: if isOwner(uid) && 
        request.resource.data.keys().hasAll(['uid', 'email', 'role', 'kycStatus', 'createdAt']) &&
        (request.resource.data.kycStatus == 'PENDING' || request.resource.data.kycStatus == 'VERIFIED' || request.resource.data.kycStatus == 'NOT_STARTED');
      allow update: if isOwner(uid) || isAdmin();
      allow delete: if isAdmin();

      match /transactions/{transactionId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create: if isSignedIn();
        allow update: if isAdmin();
      }

      match /balances/{assetId} {
        allow read: if isOwner(uid) || isAdmin();
        allow write: if isSignedIn();
      }

      match /admin_notifications/{notificationId} {
        allow read, update: if isOwner(uid) || isAdmin();
        allow create, delete: if isAdmin();
      }
    }

    // Global transactions view for admin (Collection Group)
    match /{path=**}/transactions/{transactionId} {
       allow read: if isAdmin();
    }
    
    // For admin user search/list
    match /users/{uid} {
       allow list: if isAdmin();
    }
  }
}
